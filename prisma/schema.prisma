// Myenge ma Bonakristo — database schema.
// Change it with `pnpm db:migrate` (creates a migration in prisma/migrations), never `db push`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  /// Choir director / musician: can submit scores and recordings (always as drafts).
  CONTRIBUTOR
  ADMIN
}

/// Moderation state of contributed content (scores, recordings).
enum ReviewStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

/// Format the player renders (other uploads are converted to one of these).
enum ScoreFormat {
  MUSICXML
  ABC
  MEI
}

enum ScoreKind {
  SATB
  MELODY
  PIANO
  OTHER
}

enum ConversionStatus {
  READY
  PENDING
  FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum SongStatus {
  DRAFT
  FINISHED
}

enum VersionType {
  ORIGINAL
  DEMO
  REWRITE
}

enum TagCategory {
  MOOD
  THEME
  STYLE
  ERA
}

enum CollectionStatus {
  PRIVATE
  PUBLIC
  PENDING_REVIEW
}

// ─── Auth (Better Auth: user / session / account / verification) ────────────

model User {
  id            String       @id @default(uuid())
  /// Better Auth "name" field, mapped in src/lib/auth.ts.
  displayName   String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  role          Role         @default(USER)
  banned        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  likes         Like[]
  collections   Collection[]
  annotations   Annotation[]
  songNotes     SongNote[]
  setlists      Setlist[]
  tunes         Tune[]       @relation("TuneCreatedBy")
  scoreFiles    ScoreFile[]  @relation("ScoreCreatedBy")
  scoreReviews  ScoreFile[]  @relation("ScoreReviewedBy")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─── Hymns ──────────────────────────────────────────────────────────────────

model Song {
  id              String           @id @default(uuid())
  /// Hymn number in Myenge ma Bonakristo.
  index           Int              @unique
  title           String
  status          SongStatus       @default(DRAFT)
  /// Page in the printed book, so readers can match it.
  page            Int?
  /// Melody / tune name as printed in the book (e.g. "Old Hundredth").
  tune            String?
  /// The melody this hymn is sung to (scores live on the Tune).
  tuneId          String?
  tuneRef         Tune?            @relation(fields: [tuneId], references: [id], onDelete: SetNull)
  /// Normalised title + lyrics + references, for diacritic-insensitive search (see src/lib/duala.ts).
  searchText      String           @default("")
  originalSongId  String?
  originalSong    Song?            @relation("SongOriginal", fields: [originalSongId], references: [id])
  rewrites        Song[]           @relation("SongOriginal")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  versions        SongVersion[]
  songAuthors     SongAuthor[]
  songTags        SongTag[]
  songLanguages   SongLanguage[]
  notes           SongNote[]
  likes           Like[]
  collectionSongs CollectionSong[]
  references      SongReference[]
  setlistItems    SetlistItem[]

  @@index([tuneId])
}

model SongVersion {
  id            String       @id @default(uuid())
  songId        String
  song          Song         @relation(fields: [songId], references: [id], onDelete: Cascade)
  versionType   VersionType  @default(ORIGINAL)
  /// Structured lyrics: { blocks: [{ kind: "stanza" | "refrain" | "text", number?, lines[] }], refrainAfterEachStanza }.
  /// See src/lib/lyrics.ts. Source of truth when present.
  content       Json?
  /// Plain-text rendering of `content` (kept for search, annotations and older clients).
  lyrics        String
  versionNumber Int
  createdAt     DateTime     @default(now())
  previews      Preview[]
  annotations   Annotation[]

  @@unique([songId, versionNumber])
}

/// Another hymnal a hymn is cross-referenced to ("M.B.", "S. S. et S.", "Evang. S."...).
model Hymnal {
  id          String          @id @default(uuid())
  /// Abbreviation as printed in the book, e.g. "S. S. et S.".
  code        String          @unique
  name        String
  description String?
  /// Other spellings found in the book ("SS&S", "S.S.S."), used when importing.
  aliases     String[]        @default([])
  sortOrder   Int             @default(0)
  references  SongReference[]
}

model SongReference {
  id           String @id @default(uuid())
  songId       String
  song         Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  hymnalId     String
  hymnal       Hymnal @relation(fields: [hymnalId], references: [id], onDelete: Cascade)
  /// Number in that hymnal; text because some are like "11a".
  number       String
  displayOrder Int    @default(0)

  @@unique([songId, hymnalId, number])
  @@index([hymnalId])
}

model Author {
  id          String       @id @default(uuid())
  name        String
  bio         String?
  songAuthors SongAuthor[]
}

model SongAuthor {
  songId       String
  authorId     String
  displayOrder Int    @default(1)
  song         Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  author       Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([songId, authorId])
}

model Tag {
  id       String      @id @default(uuid())
  key      String      @unique
  name     Json
  category TagCategory
  songTags SongTag[]
}

model SongTag {
  songId String
  tagId  String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([songId, tagId])
}

model Language {
  id            String         @id @default(uuid())
  code          String         @unique
  name          Json
  songLanguages SongLanguage[]
}

model SongLanguage {
  songId     String
  languageId String
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([songId, languageId])
}

model Preview {
  id              String      @id @default(uuid())
  songVersionId   String
  songVersion     SongVersion @relation(fields: [songVersionId], references: [id], onDelete: Cascade)
  fileUrl         String
  durationSeconds Int
  uploadedAt      DateTime    @default(now())
}

// ─── People's lists ─────────────────────────────────────────────────────────

model Collection {
  id              String           @id @default(uuid())
  name            Json
  description     Json?
  isPublic        Boolean          @default(false)
  status          CollectionStatus @default(PRIVATE)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  collectionSongs CollectionSong[]
}

model CollectionSong {
  collectionId String
  songId       String
  displayOrder Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  song         Song       @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([collectionId, songId])
}

/// A service programme ("Programme du culte"), shareable by link / QR code.
model Setlist {
  id        String        @id @default(uuid())
  /// Short public code used in the share link (/p/<code>).
  code      String        @unique
  title     String
  date      DateTime?
  notes     String?
  /// Anyone with the link can open it when true.
  shared    Boolean       @default(true)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  items     SetlistItem[]

  @@index([userId])
}

model SetlistItem {
  id        String  @id @default(uuid())
  setlistId String
  setlist   Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  position  Int
  /// Moment of the service ("Entrée", "Offrande"...).
  label     String?
  /// Empty for a non-hymn moment (reading, prayer).
  songId    String?
  song      Song?   @relation(fields: [songId], references: [id], onDelete: SetNull)
  /// Stanza numbers to sing; empty = all.
  stanzas   Int[]   @default([])
  note      String?

  @@index([setlistId])
}

model Annotation {
  id            String      @id @default(uuid())
  songVersionId String
  songVersion   SongVersion @relation(fields: [songVersionId], references: [id], onDelete: Cascade)
  lineNumber    Int
  lineText      String
  note          String
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
}

model SongNote {
  id          String   @id @default(uuid())
  songId      String
  song        Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  content     String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  songId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, songId])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String
  metadata  Json     @default("{}")
  userId    String?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}

// ─── Music: tunes, scores, background jobs ──────────────────────────────────

/// A melody, shared by every hymn sung to it.
model Tune {
  id          String       @id @default(uuid())
  name        String
  /// Key as written, e.g. "G", "Eb", "D minor".
  key         String?
  /// Time signature, e.g. "4/4", "3/4".
  timeSignature String?
  /// Poetic metre, e.g. "8.7.8.7" or "L.M.".
  metre       String?
  composer    String?
  /// Where the score comes from (URL or book reference).
  source      String?
  /// Licence of the score, e.g. "Domaine public", "CC BY-SA 4.0".
  license     String?
  notes       String?
  createdById String?
  createdBy   User?        @relation("TuneCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  songs       Song[]
  scores      ScoreFile[]

  @@index([name])
}

/// One score of a tune (SATB, melody only...). The rendered file is MusicXML, ABC or MEI.
model ScoreFile {
  id               String           @id @default(uuid())
  tuneId           String
  tune             Tune             @relation(fields: [tuneId], references: [id], onDelete: Cascade)
  label            String
  kind             ScoreKind        @default(SATB)
  /// Format of the rendered file (null while a conversion is pending).
  format           ScoreFormat?
  /// SA Storage full key / public URL of the file the player renders.
  fileKey          String?
  fileUrl          String?
  /// The file as uploaded (.mscz, .mid, .mxl...), kept for later conversions.
  originalKey      String?
  originalUrl      String?
  originalName     String?
  originalFormat   String?
  conversion       ConversionStatus @default(READY)
  conversionError  String?
  status           ReviewStatus     @default(DRAFT)
  /// Shown first on the hymn page.
  isDefault        Boolean          @default(false)
  source           String?
  license          String?
  createdById      String?
  createdBy        User?            @relation("ScoreCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById     String?
  reviewedBy       User?            @relation("ScoreReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote       String?
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([tuneId])
  @@index([status])
}

/// Work done by the background worker on the server (worker/), e.g. score conversion.
model Job {
  id         String    @id @default(uuid())
  type       String
  status     JobStatus @default(QUEUED)
  payload    Json      @default("{}")
  result     Json?
  error      String?
  attempts   Int       @default(0)
  runAfter   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([type])
}
