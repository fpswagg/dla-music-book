# =============================================================================
# Myenge ma Bonakristo — environment variables
# =============================================================================
# Copy to .env and fill in. Every integration is optional except where marked
# REQUIRED; the app checks them in src/lib/config.ts and degrades cleanly.
# The admin overview (/admin) shows what is configured.

# -----------------------------------------------------------------------------
# Database — REQUIRED in production
# PostgreSQL. Without it the app runs in demo mode on src/lib/mock/data.json.
# Apply migrations with `pnpm db:deploy` (never `prisma db push`).
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Auth (Better Auth, sessions in our database) — REQUIRED in production
# Secret: 32+ random characters, e.g. `openssl rand -base64 32`.
# Without it in production, sign-in is disabled (the site stays readable).
# BETTER_AUTH_URL: public URL of the site (used for links in emails and OAuth
# callbacks). Falls back to NEXT_PUBLIC_APP_URL, then to the Vercel URL.
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=https://myenge-ma-bonakristo.vercel.app

# Optional: comma-separated emails that become ADMIN when they sign up / sign in.
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Google sign-in — optional
# Both set → "Continue with Google" is shown. Missing → button hidden.
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Email via Resend — optional
# Both set → address verification on sign-up, "forgot password", magic links.
# Missing → no email is sent: sign-up works without verification and admins
# hand out reset links from /admin/users. In development the email text (with
# its link) is printed to the server console instead.
# RESEND_FROM: a sender on a domain verified in Resend, e.g.
# "Myenge ma Bonakristo <noreply@example.org>".
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=

# -----------------------------------------------------------------------------
# SA Storage — optional (audio previews + JSON backups)
# Token is server-only; its key prefix is applied by SA Storage.
# Missing → audio upload and backups are disabled (audio links still work).
# -----------------------------------------------------------------------------
SASTORAGE_URL=https://sastorage.fpswagg.site
SASTORAGE_TOKEN=

# -----------------------------------------------------------------------------
# One-off cut-over only (prisma/scripts/import-from-supabase.ts) — optional
# Read-only connection string of the old Supabase Postgres.
# -----------------------------------------------------------------------------
SOURCE_DATABASE_URL=
